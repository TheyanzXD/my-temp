# =============================================================
# MyTemp — Cloudflare Pages configuration
# Copy this file to .env (for local dev) and also mirror the
# values in Cloudflare Dashboard → Pages → Settings → Variables
# and wrangler.toml (for non-secret defaults).
# =============================================================

# Mail provider: webhook | cloudflare | mock | mailgw | mailslurp | improvmx | forwardemail
MAIL_PROVIDER=webhook

# Comma-separated list of domains the webhook provider advertises
# and accepts inbound mail for. Must be domains you actually own
# and have wired to Cloudflare Email Routing / ImprovMX / ForwardEmail.
CUSTOM_DOMAINS=yoai.my.id

# Public URL of the deployed app (used in CORS / share links)
APP_URL=https://yoai.my.id

# Display name shown in the UI
APP_NAME=MyTemp

# Mailbox lifetime in minutes (used only by mock/webhook providers)
MAILBOX_LIFETIME_MINUTES=60

# Rate limit: requests per IP per minute (per route)
MAX_REQUESTS_PER_MINUTE=120

# CORS allowed origins — * for public API, restrict to your domain in production
CORS_ALLOWED_ORIGINS=*

# ----- Optional secrets (set via `wrangler pages secret put <NAME>`) -----

# Required for MAIL_PROVIDER=mailslurp
# MAIL_API_KEY=your_mailslurp_api_key
# MAIL_API_URL=https://api.mailslurp.com

# Shared secret to authenticate inbound webhook POSTs.
# The provider must send it as: Authorization: Bearer <value>
# or x-webhook-secret: <value>
# WEBHOOK_SECRET=replace_me_with_a_long_random_string
