{
	"name": "yanzxd",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "wrangler pages deploy .svelte-kit/cloudflare --project-name yanzxd --commit-dirty=true",
		"deploy:preview": "wrangler pages deploy .svelte-kit/cloudflare --project-name yanzxd --branch preview --commit-dirty=true",
		"kv:create": "wrangler kv:namespace create MAILBOX_STORE && wrangler kv:namespace create RATE_LIMIT",
		"kv:create:preview": "wrangler kv:namespace create MAILBOX_STORE --preview && wrangler kv:namespace create RATE_LIMIT --preview",
		"secret:set": "wrangler pages secret put WEBHOOK_SECRET --project-name yanzxd",
		"secret:set:mail_api_key": "wrangler pages secret put MAIL_API_KEY --project-name yanzxd",
		"secret:set:mail_api_url": "wrangler pages secret put MAIL_API_URL --project-name yanzxd"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"lucide-svelte": "^1.0.1",
		"sanitize-html": "^2.17.7",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260916.1",
		"@sveltejs/adapter-cloudflare": "^7.0.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/sanitize-html": "^2.16.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.20.0"
	},
	"allowScripts": {
		"esbuild": true,
		"workerd": true
	}
}
